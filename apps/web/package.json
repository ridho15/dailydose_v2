{
  "name": "@dailydose/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev -p ${WEB_PORT:-32120}",
    "build": "NEXT_DIST_DIR=.next next build && node -e \"const fs=require('node:fs'); fs.mkdirSync('.next/standalone/apps/web/.next', {recursive:true}); fs.cpSync('.next/static', '.next/standalone/apps/web/.next/static', {recursive:true, force:true}); fs.cpSync('public', '.next/standalone/apps/web/public', {recursive:true, force:true});\"",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test --config=playwright.real.config.ts",
    "test:e2e:staff": "playwright test --config=playwright.real.config.ts e2e/real/staff-instructor-journey.spec.ts",
    "test:e2e:mock": "node e2e/support/run-mock-e2e.mjs",
    "test:e2e:customer": "DD_CUSTOMER_FULLSTACK=true playwright test e2e/customer-fullstack.spec.ts --grep @customer-fullstack",
    "help:screenshots": "playwright test --config=playwright.help.config.ts"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.26.0",
    "next": "^15.5.21",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.22",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "vitest-axe": "^0.1.0"
  }
}
