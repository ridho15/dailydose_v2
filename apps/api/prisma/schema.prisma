  @@map("migrations")
}

/// Jejak audit perubahan akun dan akses staf. Sengaja tanpa relasi FK agar riwayat tetap ada
/// walau pengguna dihapus; `detail` tidak boleh memuat kata sandi atau data pribadi sensitif.
model AuditLog {
  id            String   @id @default(uuid()) @db.Char(36)
  action        String   @db.VarChar(80)
  actorId       String?  @db.Char(36)
  targetUserId  String?  @db.Char(36)
  branchId      String?  @db.Char(36)
  correlationId String?  @db.VarChar(64)
  reason        String?  @db.Text
  detail        Json?
  // Objek yang diubah (mis. "Branch", "Package"), selain `targetUserId` untuk aksi atas akun pengguna.
  objectType    String?  @db.VarChar(40)
  objectId      String?  @db.VarChar(64)
  createdAt     DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@index([objectType, objectId, createdAt])
  @@map("audit_log")
}

/// Kasus bantuan pelanggan yang ditangani staf. `version` dipakai klaim optimistik saat ubah.
model SupportCase {
  id             String              @id @default(uuid()) @db.Char(36)
  subject        String              @db.VarChar(200)
  customerId     String              @db.Char(36)
  branchId       String?             @db.Char(36)
  priority       SupportCasePriority @default(NORMAL)
  status         SupportCaseStatus   @default(OPEN)
  tags           Json
  assignedUserId String?             @db.Char(36)
  createdById    String?             @db.Char(36)
  version        Int                 @default(1)
  resolvedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  customer     User              @relation("SupportCaseCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  branch       Cabang?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignedUser User?             @relation("SupportCaseAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  notes        SupportCaseNote[]

  @@index([branchId, status, createdAt])
  @@index([customerId])
  @@index([assignedUserId, status])
  @@map("support_case")
}

/// Catatan pada kasus bantuan. Saat ini seluruhnya internal (tidak terlihat pelanggan).
model SupportCaseNote {
  id        String   @id @default(uuid()) @db.Char(36)
  caseId    String   @db.Char(36)
  body      String   @db.Text
  internal  Boolean  @default(true)
  authorId  String?  @db.Char(36)
  createdAt DateTime @default(now())

  supportCase SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author      User?       @relation("SupportCaseNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@map("support_case_note")
}

/// Konten situs publik yang dikelola staf (mis. slider beranda). Versi baru selalu DRAFT; terbit
/// mengarsipkan versi terbit sebelumnya untuk kunci + cakupan + bahasa yang sama.
model PublicContent {
  id          String              @id @default(uuid()) @db.Char(36)
  contentKey  String              @db.VarChar(64)
  scopeKey    String              @db.VarChar(40)
  branchId    String?             @db.Char(36)
  kind        String              @db.VarChar(32)
  locale      String              @default("id-ID") @db.VarChar(10)
  version     Int
  status      PublicContentStatus @default(DRAFT)
  payload     Json
  createdById String?             @db.Char(36)
  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([contentKey, scopeKey, locale, version])
  @@index([kind, status, scopeKey])
  @@map("public_content")
}

/// Template pesan notifikasi yang dikelola staf. Versi terbit dipakai saat pesan dikirim; bila tidak ada
/// versi terbit, pengirim memakai teks bawaan dari registry template.
model NotificationTemplate {
  id          String                     @id @default(uuid()) @db.Char(36)
  templateKey String                     @db.VarChar(64)
  channel     String                     @db.VarChar(16)
  version     Int
  eventType   String                     @db.VarChar(64)
  audience    Json?
  subject     String?                    @db.VarChar(200)
  title       String                     @db.VarChar(200)
  body        String                     @db.Text
  status      NotificationTemplateStatus @default(DRAFT)
  createdById String?                    @db.Char(36)
  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@unique([templateKey, channel, version])
  @@index([templateKey, channel, status])
  @@map("notification_template")
}

enum EmailDeliveryStatus {
  PENDING
  SENDING
  ACCEPTED_BY_SMTP
  FAILED_RETRYABLE
  FAILED_TERMINAL
  EXPIRED
  FALLBACK_IN_APP
}

/// Antrean email transaksional. `envelope` (penerima + variabel, termasuk tautan sekali pakai) disimpan
/// terenkripsi AES-256-GCM; kolom lain tidak memuat alamat maupun token. `occurrenceKey` unik agar
/// peristiwa yang sama tidak dikirim dua kali.
model EmailDelivery {
  id                 String              @id @default(uuid()) @db.Char(36)
  occurrenceKey      String              @unique @db.VarChar(64)
  eventType          String              @db.VarChar(96)
  templateKey        String              @db.VarChar(64)
  recipientMasked    String              @db.VarChar(120)
  envelope           String              @db.Text
  status             EmailDeliveryStatus @default(PENDING)
  attemptCount       Int                 @default(0)
  maxAttempts        Int                 @default(5)
  rateLimitWaitCount Int                 @default(0)
  nextAttemptAt      DateTime?
  lastErrorCode      String?             @db.VarChar(48)
  lastAttemptAt      DateTime?
  acceptedAt         DateTime?
  expiresAt          DateTime?
  correlationId      String              @db.VarChar(96)
  userId             String?             @db.Char(36)
  branchId           String?             @db.Char(36)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status, nextAttemptAt])
  @@index([createdAt, id])
  @@map("email_delivery")
}

/// Promosi harga sebuah paket dalam rentang waktu. Hanya satu promosi ACTIVE yang boleh berlaku pada
/// satu paket di waktu yang sama; `version` dipakai klaim optimistik saat ubah atau ganti status.
model PackagePromotion {
  id            String                @id @default(uuid()) @db.Char(36)
  packageId     String                @db.Char(36)
  name          String                @db.VarChar(80)
  label         String                @db.VarChar(40)
  discountType  PromotionDiscountType
  discountValue Int
  activeFrom    DateTime
  activeUntil   DateTime
  status        PromotionStatus       @default(ACTIVE)
  version       Int                   @default(1)
  createdById   String?               @db.Char(36)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  package Paket @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, status, activeFrom, activeUntil])
  @@map("package_promotion")
}

/// Ulasan member untuk instruktur kelas yang ia hadiri (bintang 1-5 dan komentar opsional).
/// Internal saja, tidak tampil di situs publik. Satu baris per booking. `rating` kosong berarti member
/// melewati ulasan untuk kelas itu, supaya tidak ditanya lagi.
/// Sengaja tanpa relasi Prisma agar tabel lain tidak berubah sama sekali; id diisi dari booking.
model UlasanInstruktur {
  id           String   @id @default(uuid()) @db.Char(36)
  bookingId    String   @unique @db.Char(36)
  userId       String   @db.Char(36)
  classSlotId  String   @db.Char(36)
  instructorId String   @db.Char(36)
  branchId     String   @db.Char(36)
  rating       Int?     @db.TinyInt
  comment      String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([instructorId, createdAt])
  @@index([branchId, createdAt])
  @@map("ulasan_instruktur")
}

/// Porsi laba cabang untuk tiap Super Owner, dipakai settlement akhir bulan di Jurnal kas.
/// Basis poin: 10000 = 100%. Porsi satu cabang berjumlah 100%. Tanpa relasi Prisma agar tabel lain
/// tidak berubah.
model PorsiOwnerCabang {
  id          String   @id @default(uuid()) @db.Char(36)
  branchId    String   @db.Char(36)
  ownerId     String   @db.Char(36)
  porsiBp     Int
  updatedById String?  @db.Char(36)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([branchId, ownerId])
  @@map("porsi_owner_cabang")
}

/// Pengeluaran cabang yang dibayar dengan uang pribadi Super Owner; diganti (reimburse) saat
/// settlement. Pengeluaran tanpa baris di sini dibayar dari kas cabang.
model PembayarPengeluaran {
  id            String   @id @default(uuid()) @db.Char(36)
  otherCostId   String   @unique @db.Char(36)
  dibayarOlehId String   @db.Char(36)
  createdAt     DateTime @default(now())

  @@index([dibayarOlehId])
  @@map("pembayar_pengeluaran")
}

/// Rekening tujuan transfer honor instruktur, untuk berkas KlikBCA Bisnis Multi Payroll.
/// Satu rekening per instruktur. Tanpa relasi Prisma; tabel lama tidak berubah.
model RekeningInstruktur {
  instructorId  String   @id @db.Char(36)
  bankName      String   @db.VarChar(64)
  /// SWIFT bank tujuan; CENAIDJA berarti sesama BCA, selain itu transfer LLG.
  swiftCode     String   @db.VarChar(11)
  accountNumber String   @db.VarChar(34)
  accountName   String   @db.VarChar(70)
  /// Notifikasi transfer berhasil dari BCA (opsional).
  email         String?  @db.VarChar(191)
  updatedById   String?  @db.Char(36)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("rekening_instruktur")
}

/// Modal per sesi untuk menghitung profit: sesi paket yang dibeli member x modal per sesi tipe
/// kelasnya di cabang itu. Terpisah dari fee instruktur (yang dibayar per kelas ter-scan QR).
/// classTypeId kosong = berlaku untuk semua tipe kelas di cabang itu (dipakai paket umum).
/// Tanpa relasi Prisma; tabel lama tidak berubah.
model ModalSesi {
  id             String   @id @default(uuid()) @db.Char(36)
  branchId       String   @db.Char(36)
  classTypeId    String?  @db.Char(36)
  modalPerSesiRp Int
  effectiveDate  DateTime @db.Date
  createdById    String?  @db.Char(36)
  createdAt      DateTime @default(now())

  @@index([branchId, classTypeId, effectiveDate])
  @@map("modal_sesi")
}

/// Kapasitas kelas per cabang dan tipe kelas dari Data Master (Kuota & Kapasitas). Bila ada,
/// dipakai untuk kelas baru dan kelas mendatang menggantikan kapasitas bawaan tipe kelas.
/// Tanpa relasi Prisma; tabel lama tidak berubah.
model KapasitasKelasCabang {
  id          String   @id @default(uuid()) @db.Char(36)
  branchId    String   @db.Char(36)
  classTypeId String   @db.Char(36)
  capacity    Int
  updatedById String?  @db.Char(36)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([branchId, classTypeId])
  @@map("kapasitas_kelas_cabang")
}
