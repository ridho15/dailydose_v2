  instructorId String   @db.Char(36)
  branchId     String   @db.Char(36)
  date         DateTime @db.Date
  startTime    String   @db.VarChar(8)
  endTime      String   @db.VarChar(8)
  createdAt    DateTime @default(now())

  instructor User   @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  branch     Cabang @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([instructorId, date])
  @@map("instructor_availability")
}

model ReminderLog {
  id             String   @id @default(uuid()) @db.Char(36)
  recipientPhone String   @db.VarChar(32)
  recipientType  String   @db.VarChar(16)
  reminderType   String   @db.VarChar(64)
  payload        Json?
  status         String   @default("SENT") @db.VarChar(16)
