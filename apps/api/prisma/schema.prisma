// WARISAN: fitur proyeksi biaya instruktur dihapus (2026-10-25). Tabel dipertahankan tanpa dikelola dari
// aplikasi agar tidak ada perubahan skema yang destruktif; barisnya dibersihkan otomatis saat cabang atau
// tipe kelas induknya dihapus (LifecycleService, LEGACY_TABLES).
model ProjectionRate {
  id            String   @id @default(uuid()) @db.Char(36)
  branchId      String   @db.Char(36)
  classTypeId   String   @db.Char(36)
  ratePerSesiRp Int
  effectiveDate DateTime @db.Date
  createdAt     DateTime @default(now())

  branch    Cabang     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  classType JenisKelas @relation(fields: [classTypeId], references: [id], onDelete: Restrict)

  @@index([branchId, classTypeId, effectiveDate])
  @@map("projection_rate")
}

model OtherCost {
  id          String   @id @default(uuid()) @db.Char(36)
  branchId    String   @db.Char(36)
  // Bulan pengeluaran (YYYY-MM), diturunkan dari `incurredOn`; baris lama hanya punya ini.
  period      String   @db.VarChar(7)
  // Tanggal pengeluaran; kosong pada baris lama (dihitung pada tanggal 1 bulannya).
  incurredOn  DateTime? @db.Date
  category    String   @default("OTHER") @db.VarChar(64)
  description String   @db.Text
  amountRp    Int
  createdById String?  @db.Char(36)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch    Cabang @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy User?  @relation("OtherCostCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([branchId, period])
  @@index([branchId, incurredOn])
  @@map("other_cost")
}

model MonthlyClose {
  id               String      @id @default(uuid()) @db.Char(36)
  branchId         String      @db.Char(36)
  period           String      @db.VarChar(7)
  omsetRp          Int         @default(0)
  // Riwayat tutup buku sebelum proyeksi dihapus; tutup buku baru menyimpan 0.
  costProjectionRp Int         @default(0)
  costRealtimeRp   Int         @default(0)
  otherCostRp      Int         @default(0)
  profitRp         Int         @default(0)
  status           CloseStatus @default(OPEN)
  controlHash      String?     @db.VarChar(128)
  closedById       String?     @db.Char(36)
  closedAt         DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  branch   Cabang @relation(fields: [branchId], references: [id], onDelete: Restrict)
  closedBy User?  @relation("MonthlyCloseUser", fields: [closedById], references: [id], onDelete: SetNull)

  @@unique([branchId, period])
  @@map("monthly_close")
}

model CorrectionJournal {
  id            String           @id @default(uuid()) @db.Char(36)
  branchId      String           @db.Char(36)
  period        String           @db.VarChar(7)
  targetPeriod  String           @db.VarChar(7)
  amountRp      Int
  reason        String           @db.Text
  status        CorrectionStatus @default(PENDING)
  requestedById String           @db.Char(36)
  approvedById  String?          @db.Char(36)
  approvedAt    DateTime?
  // Alasan keputusan (kontrak `ReasonCommand`) dan penjaga konkurensi optimistis.
  decisionReason String?         @db.Text
  version       Int              @default(1)
  createdAt     DateTime         @default(now())

  branch      Cabang @relation(fields: [branchId], references: [id], onDelete: Restrict)
  requestedBy User   @relation("CorrectionRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  User?  @relation("CorrectionApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([branchId, period])
  @@map("correction_journal")
}

model SessionAdjustRequest {
  id                String              @id @default(uuid()) @db.Char(36)
  customerPackageId String              @db.Char(36)
  bookingId         String?             @db.Char(36)
  reason            String              @db.Text
  sessionCount      Int                 @default(1)
  status            AdjustRequestStatus @default(PENDING)
  requestedById     String              @db.Char(36)
  approvedById      String?             @db.Char(36)
  decisionReason    String?             @db.Text
  // Kode terkontrol untuk kontrak /session-adjustments; `reason`/`decisionReason` tetap teks bebas.
  reasonCode        String?             @db.VarChar(40)
  decisionCode      String?             @db.VarChar(40)
  decisionNote      String?             @db.Text
  // Penjaga konkurensi optimistis: dinaikkan tiap keputusan, dicocokkan dengan expectedVersion.
  version           Int                 @default(1)
  createdAt         DateTime            @default(now())
  decidedAt         DateTime?

  customerPackage PaketPelanggan  @relation(fields: [customerPackageId], references: [id], onDelete: Cascade)
  booking         PemesananKelas? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  requestedBy     User            @relation("AdjustRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy      User?           @relation("AdjustApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([customerPackageId, status])
  @@map("session_adjust_request")
}

model InstructorAvailability {
