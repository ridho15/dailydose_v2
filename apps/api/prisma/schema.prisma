}

model PasswordActionToken {
  id           String    @id @default(uuid()) @db.Char(36)
  kind         String    @db.VarChar(32)
  tokenHash    String    @unique @db.VarChar(191)
  emailHash    String    @db.VarChar(191)
  userId       String?   @db.Char(36)
  invitationId String?   @db.Char(36)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

