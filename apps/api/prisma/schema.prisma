datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  SUPER_OWNER
  OWNER
  MANAGER
  FINANCE
  ADMIN
  INSTRUCTOR
  CUSTOMER
  SUPERADMIN
  COACH
  MEMBER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SessionMutationType {
  PURCHASE
  ATTEND
  REFUND_AUTOCANCEL
  ADJUST_MANUAL
}

enum AdjustRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CloseStatus {
  OPEN
  LOCKED
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BankMutationStatus {
  UNMATCHED
  MATCHED
  MANUAL_REVIEW
}

enum ClassModality {
  GROUP
  PRIVATE
  DUET
  SEMI_PRIVATE
}

enum PackageStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PurchaseStatus {
  PENDING
  WAITING_VERIFICATION
  PAID
  CANCELLED
  REJECTED
}

enum CustomerPackageStatus {
  ACTIVE
  DEPLETED
  EXPIRED
  FROZEN
}

enum PromotionDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromotionStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum NotificationTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PublicContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SupportCasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportCaseStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum ClassSlotStatus {
  DRAFT
  PUBLISHED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  BOOKED
  ATTENDED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  BANK_TRANSFER
  QRIS
  CASH
  CARD
  MANUAL_STAFF
}

enum RescheduleStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CheckInMethod {
  QR_SCAN
  MANUAL_FRONTDESK
  WEB_LINK
}

// ============================================================================
// PILAR 1: FASILITAS & MULTI-CABANG
// ============================================================================

model Cabang {
  id                  String   @id @default(uuid()) @db.Char(36)
  code                String   @unique @db.VarChar(32)
  name                String   @db.VarChar(128)
  address             String?  @db.Text
  supportWhatsappE164 String?  @map("phone") @db.VarChar(32)
  timezone            String   @default("Asia/Jakarta") @db.VarChar(64)
  heroImageKey        String?  @map("hero_image_key") @db.VarChar(255)
  galleryImageKeys    Json?    @map("gallery_image_keys")
  latitude            Decimal? @db.Decimal(10, 7)
  longitude           Decimal? @db.Decimal(10, 7)
  geofenceRadiusMeters Int     @default(100)
  /// Target omzet bulanan cabang ini, rupiah. Dipasang Super Owner di menu cabang dan berlaku
  /// terus sampai diubah. Null berarti belum dipasang, bukan nol.
  monthlyTargetRp     Int?     @map("monthly_target_rp")
  /// HMAC dari PIN 6 digit tablet kiosk; kosong = kiosk cabang ini terkunci. PIN asli tidak pernah disimpan.
  kioskPinHash        String?  @map("kiosk_pin_hash") @db.VarChar(64)
  kioskPinUpdatedAt   DateTime? @map("kiosk_pin_updated_at")
  active              Boolean  @default(true) @map("isActive")
  /// Diisi saat diarsipkan: disembunyikan dari daftar kerja, riwayat tetap utuh. Beda dari sekadar nonaktif.
  archivedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  studios               Studio[]
  classSlots            SlotKelas[]
  instructorAssignments PenugasanInstruktur[]
  purchases             Pembelian[]
  paymentAccounts       RekeningPembayaran[]
  supportCases          SupportCase[]
  ownerAssignments      OwnerCabang[]
  minQuotaSettings      MinQuotaSetting[]
  instructorFees        InstructorFee[]
  projectionRates       ProjectionRate[]
  otherCosts            OtherCost[]
  monthlyCloses         MonthlyClose[]
  correctionJournals    CorrectionJournal[]
  instructorAvailabilities InstructorAvailability[]
  packages              Paket[]
  bookings              PemesananKelas[]

  @@map("cabang")
}

model Studio {
  id                  String   @id @default(uuid()) @db.Char(36)
  branchId            String   @db.Char(36)
  code                String   @db.VarChar(32)
  name                String   @db.VarChar(128)
  description         String?  @db.Text
  imageKey            String?  @map("image_key") @db.VarChar(255)
  active              Boolean  @default(true) @map("isActive")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  branch     Cabang      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  rooms      Ruangan[]
  classSlots SlotKelas[]

  @@unique([branchId, code])
  @@index([branchId, active])
  @@map("studio")
}

model Ruangan {
  id          String   @id @default(uuid()) @db.Char(36)
  studioId    String   @db.Char(36)
  code        String   @db.VarChar(32)
  name        String   @db.VarChar(128)
  capacityBed Int      @default(1)
  active      Boolean  @default(true) @map("isActive")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studio     Studio      @relation(fields: [studioId], references: [id], onDelete: Restrict)
  classSlots SlotKelas[]

  @@unique([studioId, code])
  @@index([studioId, active])
  @@map("ruangan")
}

model JenisKelas {
  id              String        @id @default(uuid()) @db.Char(36)
  code            String        @unique @db.VarChar(32)
  name            String        @db.VarChar(128)
  modality        ClassModality @default(GROUP)
  description     String?       @db.Text
  durationMinutes Int           @default(50)
  defaultCapacity Int           @default(8)
  heroImageKey    String?       @map("hero_image_key") @db.VarChar(255)
  galleryImageKeys Json?        @map("gallery_image_keys")
  active          Boolean       @default(true) @map("isActive")
  /// Diisi saat diarsipkan (lihat Cabang.archivedAt).
  archivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  packages         Paket[]
  classSlots       SlotKelas[]
  minQuotaSettings MinQuotaSetting[]
  instructorFees   InstructorFee[]
  projectionRates  ProjectionRate[]

  @@map("jenis_kelas")
}

// ============================================================================
// PILAR 2: PENGGUNA & PERAN
// ============================================================================

model User {
  id                String     @id @default(uuid()) @db.Char(36)
  email             String?    @unique @db.VarChar(191)
  phone             String?    @unique @db.VarChar(32)
  username          String?    @unique @db.VarChar(64)
  displayName       String     @map("name") @db.VarChar(128)
  passwordHash      String?    @db.VarChar(255)
  role              Role       @default(CUSTOMER)
  status            UserStatus @default(ACTIVE)
  rememberToken     String?    @map("remember_token") @db.VarChar(100)
  preferredBranchId String?    @db.Char(36)
  stoppedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  profile               ProfilPengguna?
  sessions              UserSession[]
  instructorAssignments PenugasanInstruktur[]
  instructedClassSlots  SlotKelas[]           @relation("InstructorSlot")
  purchases             Pembelian[]
  customerPackages      PaketPelanggan[]
  bookings              PemesananKelas[]
  verifiedPurchases     Pembelian[]           @relation("PurchaseVerifier")
  recordedAttendances   KehadiranPelanggan[]  @relation("AttendanceRecorder")
  instructorAttendances KehadiranInstruktur[] @relation("InstructorAttendee")
  recordedInstructorAttendances KehadiranInstruktur[] @relation("InstructorAttendanceRecorder")
  issuedInstructorTokens InstructorCheckInToken[] @relation("InstructorTokenIssuer")
  supportCasesAsCustomer SupportCase[]         @relation("SupportCaseCustomer")
  assignedSupportCases  SupportCase[]          @relation("SupportCaseAssignee")
  supportCaseNotes      SupportCaseNote[]      @relation("SupportCaseNoteAuthor")
  ownedBranches         OwnerCabang[]
  instructorFees        InstructorFee[]
  createdSessionLedgers SessionLedger[]       @relation("LedgerCreator")
  createdOtherCosts     OtherCost[]           @relation("OtherCostCreator")
  closedMonths          MonthlyClose[]        @relation("MonthlyCloseUser")
  requestedCorrections  CorrectionJournal[]   @relation("CorrectionRequester")
  approvedCorrections   CorrectionJournal[]   @relation("CorrectionApprover")
  requestedAdjustments  SessionAdjustRequest[] @relation("AdjustRequester")
  approvedAdjustments   SessionAdjustRequest[] @relation("AdjustApprover")
  instructorAvailabilities InstructorAvailability[]

  @@index([role, status])
  @@map("user")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           String    @db.Char(36)
  channel          String    @default("WEB") @db.VarChar(16)
  tokenFamilyHash  String    @db.VarChar(64)
  accessTokenHash  String    @unique @db.VarChar(64)
  refreshTokenHash String    @unique @db.VarChar(64)
  expiresAt        DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  revocationReason String?   @db.VarChar(64)
  rotatedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_session")
}

model ProfilPengguna {
  id                    String    @id @default(uuid()) @db.Char(36)
  userId                String    @unique @db.Char(36)
  fullName              String?   @db.VarChar(128)
  gender                String?   @db.VarChar(16)
  birthDate             DateTime? @db.Date
  avatarUrl             String?   @db.Text
  ktpUrl                String?   @map("ktp_url") @db.Text
  selfieUrl             String?   @map("selfie_url") @db.Text
  nik                   String?   @db.VarChar(32)
  address               String?   @db.Text
  emergencyContactName  String?   @db.VarChar(128)
  emergencyContactPhone String?   @db.VarChar(32)
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profil_pengguna")
}

model PenugasanInstruktur {
  id        String   @id @default(uuid()) @db.Char(36)
  coachId   String   @db.Char(36)
  branchId  String   @db.Char(36)
  active    Boolean  @default(true) @map("isActive")
  createdAt DateTime @default(now())

  coach  User   @relation(fields: [coachId], references: [id], onDelete: Restrict)
  branch Cabang @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([coachId, branchId])
  @@index([branchId, active])
  @@map("penugasan_instruktur")
}

// ============================================================================
// PILAR 3: PAKET SESI & PENJUALAN (BILLING)
// ============================================================================

model Paket {
  id           String        @id @default(uuid()) @db.Char(36)
  branchId     String?       @db.Char(36)
  classTypeId  String?       @db.Char(36)
  code         String        @unique @db.VarChar(32)
  name         String        @db.VarChar(128)
  sessionCount Int
  validityDays Int
  priceRp      Int
  description  String?       @db.Text
  status       PackageStatus @default(ACTIVE)
  isMultiBranch Boolean      @default(false) @map("is_multi_branch")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  branch           Cabang?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  classType        JenisKelas?      @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  purchases        Pembelian[]
  customerPackages PaketPelanggan[]
  promotions       PackagePromotion[]

  @@index([status, classTypeId])
  @@index([branchId])
  @@map("paket")
}

model Pembelian {
  id               String         @id @default(uuid()) @db.Char(36)
  invoiceNumber    String         @unique @db.VarChar(64)
  userId           String         @db.Char(36)
  branchId         String         @db.Char(36)
  packageId        String         @db.Char(36)
  voucherId        String?        @db.Char(36)
  subtotalRp       Int
  discountRp       Int            @default(0)
  totalAmountRp    Int
  status           PurchaseStatus @default(PENDING)
  paymentMethod    PaymentMethod  @default(BANK_TRANSFER)
  paymentExpiresAt DateTime?
  paidAt           DateTime?
  verifiedById     String?        @db.Char(36)
  verifiedAt       DateTime?
  rejectionReason  String?        @db.Text
  // Penjualan manual di meja: staf pencatat (tidak boleh menyetujui catatannya sendiri) dan catatannya.
  recordedById     String?        @db.Char(36)
  recordNote       String?        @db.VarChar(255)
  /// Promosi paket yang berlaku saat pesanan dibuat (snapshot; diskonnya sudah termasuk dalam discountRp).
  promotionId         String?     @db.Char(36)
  promotionName       String?     @db.VarChar(80)
  promotionDiscountRp Int         @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch          Cabang           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  package         Paket            @relation(fields: [packageId], references: [id], onDelete: Restrict)
  voucher         Voucher?         @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  verifiedBy      User?            @relation("PurchaseVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  paymentProof    BuktiPembayaran?
  customerPackage PaketPelanggan?
  bankMutations   MutasiBank[]

  @@index([userId, status])
  @@index([branchId, status, createdAt])
  @@index([promotionId])
  @@map("pembelian")
}

model BuktiPembayaran {
  id            String   @id @default(uuid()) @db.Char(36)
  purchaseId    String   @unique @db.Char(36)
  fileUrl       String   @db.Text
  bankName      String?  @db.VarChar(64)
  accountHolder String?  @db.VarChar(128)
  notes         String?  @db.Text
  uploadedAt    DateTime @default(now())

  purchase Pembelian @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@map("bukti_pembayaran")
}

model MutasiBank {
  id                String             @id @default(uuid()) @db.Char(36)
  bankName          String             @db.VarChar(64)
  accountNumber     String?            @db.VarChar(64)
  transactionDate   DateTime
  amountRp          Int
  description       String             @db.Text
  referenceNumber   String?            @unique @db.VarChar(128)
  status            BankMutationStatus @default(UNMATCHED)
  matchedPurchaseId String?            @db.Char(36)
  matchedAt         DateTime?
  notes             String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  matchedPurchase   Pembelian?         @relation(fields: [matchedPurchaseId], references: [id], onDelete: SetNull)

  @@index([transactionDate, amountRp])
  @@index([status])
  @@map("mutasi_bank")
}

model PaketPelanggan {
  id                String                @id @default(uuid()) @db.Char(36)
  purchaseId        String?               @unique @db.Char(36)
  userId            String                @db.Char(36)
  packageId         String                @db.Char(36)
  totalSessions     Int
  remainingSessions Int
  usedSessions      Int                   @default(0)
  validFrom         DateTime              @default(now())
  validUntil        DateTime
  status            CustomerPackageStatus @default(ACTIVE)
  /// Saat paket dibekukan staf; dipakai menambah masa berlaku ketika dibuka kembali.
  frozenAt          DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  purchase       Pembelian?             @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  package        Paket                  @relation(fields: [packageId], references: [id], onDelete: Restrict)
  bookings       PemesananKelas[]
  ledgers        SessionLedger[]
  adjustRequests SessionAdjustRequest[]

  @@index([userId, status, validUntil])
  @@map("paket_pelanggan")
}

model RekeningPembayaran {
  id            String   @id @default(uuid()) @db.Char(36)
  branchId      String?  @db.Char(36)
  bankName      String   @db.VarChar(64)
  accountNumber String   @db.VarChar(64)
  accountHolder String   @db.VarChar(128)
  active        Boolean  @default(true) @map("isActive")
  createdAt     DateTime @default(now())

  branch Cabang? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@map("rekening_pembayaran")
}

model Voucher {
  id            String    @id @default(uuid()) @db.Char(36)
  code          String    @unique @db.VarChar(32)
  name          String    @db.VarChar(128)
  discountType  String    @default("NOMINAL")
  discountValue Int
  imageKey      String?   @map("image_key") @db.VarChar(255)
  description   String?   @db.Text
  minSpendRp    Int       @default(0)
  maxDiscountRp Int?
  quota         Int       @default(100)
  usedCount     Int       @default(0)
  validUntil    DateTime?
  active        Boolean   @default(true) @map("isActive")
  /// Diisi saat diarsipkan; Jeda hanya `active=false`, arsip permanen dan tersembunyi.
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())

  purchases Pembelian[]

  @@map("voucher")
}

// ============================================================================
// PILAR 4: JADWAL & PEMESANAN KELAS (BOOKINGS)
// ============================================================================

model SlotKelas {
  id                 String          @id @default(uuid()) @db.Char(36)
  branchId           String          @db.Char(36)
  studioId           String          @db.Char(36)
  roomId             String?         @db.Char(36)
  classTypeId        String          @db.Char(36)
  instructorId       String?         @db.Char(36)
  startAt            DateTime
  endAt              DateTime
  capacity           Int
  bookedCount        Int             @default(0)
  minQuota           Int?
  status             ClassSlotStatus @default(PUBLISHED)
  notes              String?         @db.Text
  cancellationReason String?         @db.Text
  instructorFeeRp    Int?
  isManualFee        Boolean         @default(false)
  // Kunci optimistik untuk perubahan definisi/status kelas oleh staf (instruktur, jadwal, publikasi,
  // pembatalan, penyelesaian). `bookedCount` berubah lewat booking dan sengaja TIDAK menaikkan versi.
  version            Int             @default(1)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  branch                Cabang           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  studio                Studio           @relation(fields: [studioId], references: [id], onDelete: Restrict)
  room                  Ruangan?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  classType             JenisKelas       @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  instructor            User?            @relation("InstructorSlot", fields: [instructorId], references: [id], onDelete: SetNull)
  bookings              PemesananKelas[]
  instructorAttendance  KehadiranInstruktur?
  instructorCheckInTokens InstructorCheckInToken[]
  rescheduleSourceSlots UbahJadwal[]     @relation("SourceSlot")
  rescheduleTargetSlots UbahJadwal[]     @relation("TargetSlot")

  @@index([branchId, startAt, status])
  @@index([instructorId, startAt])
  @@map("slot_kelas")
}

model PemesananKelas {
  id                 String        @id @default(uuid()) @db.Char(36)
  bookingNumber      String        @unique @db.VarChar(64)
  classSlotId        String        @db.Char(36)
  branchId           String?       @db.Char(36)
  userId             String        @db.Char(36)
  customerPackageId  String        @db.Char(36)
  status             BookingStatus @default(BOOKED)
  source             String        @default("SELF") @db.VarChar(20)
  bookedAt           DateTime      @default(now())
  cancelledAt        DateTime?
  cancellationReason String?       @db.Text
  // Pengguna yang membatalkan (pelanggan sendiri atau staf); jejak karena audit belum permanen.
  cancelledById      String?       @db.Char(36)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  classSlot       SlotKelas              @relation(fields: [classSlotId], references: [id], onDelete: Restrict)
  branch          Cabang?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  customerPackage PaketPelanggan         @relation(fields: [customerPackageId], references: [id], onDelete: Restrict)
  attendance      KehadiranPelanggan?
  checkInTokens   CheckInToken[]
  reschedules     UbahJadwal[]
  adjustRequests  SessionAdjustRequest[]

  @@index([userId, status])
  @@index([classSlotId, status])
  @@index([branchId, status])
  @@index([branchId, bookedAt(sort: Desc), id(sort: Desc)])
  @@index([bookedAt(sort: Desc), id(sort: Desc)])
  @@map("pemesanan_kelas")
}

model UbahJadwal {
  id            String           @id @default(uuid()) @db.Char(36)
  bookingId     String           @db.Char(36)
  sourceSlotId  String           @db.Char(36)
  targetSlotId  String           @db.Char(36)
  requestedById String           @db.Char(36)
  status        RescheduleStatus @default(APPROVED)
  reason        String?          @db.Text
  requestedAt   DateTime         @default(now())

  booking    PemesananKelas @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sourceSlot SlotKelas      @relation("SourceSlot", fields: [sourceSlotId], references: [id], onDelete: Restrict)
  targetSlot SlotKelas      @relation("TargetSlot", fields: [targetSlotId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([status])
  @@map("ubah_jadwal")
}

// ============================================================================
// PILAR 5: PRESENSI & OPERASIONAL HARIAN
// ============================================================================

/// Token QR presensi instruktur: terikat ke kelas (bukan booking), sehingga kelas tanpa booking pun
/// dapat memakainya. Disimpan sebagai hash; diterbitkan staf studio dan dipindai instruktur pemilik kelas.
model InstructorCheckInToken {
  id          String    @id @default(uuid()) @db.Char(36)
  classSlotId String    @db.Char(36)
  token       String    @unique @db.VarChar(128)
  expiresAt   DateTime
  usedAt      DateTime?
  issuedById  String?   @db.Char(36)
  createdAt   DateTime  @default(now())

  classSlot SlotKelas @relation(fields: [classSlotId], references: [id], onDelete: Cascade)
  issuedBy  User?     @relation("InstructorTokenIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([classSlotId, expiresAt])
  @@map("instructor_check_in_token")
}

/// Presensi instruktur per kelas (satu baris per slot). Dasar validasi honor instruktur di laporan finansial.
model KehadiranInstruktur {
  id           String        @id @default(uuid()) @db.Char(36)
  classSlotId  String        @unique @db.Char(36)
  instructorId String        @db.Char(36)
  method       CheckInMethod @default(QR_SCAN)
  checkedInAt  DateTime      @default(now())
  recordedById String?       @db.Char(36)
  notes        String?       @db.VarChar(255)
  latitude     Decimal?      @db.Decimal(10, 7)
  longitude    Decimal?      @db.Decimal(10, 7)
  distanceMeters Int?
  isWithinGeofence Boolean     @default(true)

  classSlot  SlotKelas @relation(fields: [classSlotId], references: [id], onDelete: Cascade)
  instructor User      @relation("InstructorAttendee", fields: [instructorId], references: [id], onDelete: Cascade)
  recordedBy User?     @relation("InstructorAttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([instructorId, checkedInAt])
  @@map("kehadiran_instruktur")
}

model KehadiranPelanggan {
  id           String        @id @default(uuid()) @db.Char(36)
  bookingId    String        @unique @db.Char(36)
  method       CheckInMethod @default(QR_SCAN)
  checkedInAt  DateTime      @default(now())
  recordedById String?       @db.Char(36)
