NODE_ENV=development
PORT=32121
WEB_PORT=32120
API_BASE_URL=http://127.0.0.1:32121
DATABASE_URL=mysql://dailydose:dailydose_local@127.0.0.1:3306/dailydose_local
HEALTH_PROBE_TIMEOUT_MS=2000
QUOTA_EVALUATION_SYNTHETIC_ENABLED=true
QUOTA_EVALUATION_POLL_INTERVAL_MS=10000
QUOTA_EVALUATION_LEASE_MS=30000
QUOTA_EVALUATION_MAX_ATTEMPTS=5
QUOTA_EVALUATION_BACKOFF_MS=60000
# Private customer identity documents. Local persistent storage is the v1 driver.
PRIVATE_UPLOAD_DRIVER=local
PRIVATE_UPLOAD_ROOT=apps/api/.local-data/private
V1_SHARED_MEDIA_PREFIX=v1-compat/private
PRIVATE_UPLOAD_MAX_BYTES=8000000
PRIVATE_VIEW_AUTH_TTL_SECONDS=300
IDENTITY_DOCUMENT_RETENTION_DAYS=30
# Production-required provider, pricing, quota, fee, TTL, and policy values intentionally have no defaults.
AUTH_ACCESS_TTL_SECONDS=
AUTH_REFRESH_TTL_SECONDS=
AUTH_OTP_TTL_SECONDS=
AUTH_OTP_MAX_ATTEMPTS=
AUTH_INVITATION_TTL_SECONDS=

# Password sign-in, transaction email, and Google Identity Services.
AUTH_PASSWORD_ENABLED=false
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
EMAIL_DRIVER=smtp
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Daily Dose Pilates
SMTP_FROM_EMAIL=
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_MAX_ATTEMPTS=5
SMTP_RATE_LIMIT_PER_MINUTE=3
SMTP_RATE_LIMIT_PER_HOUR=150
NOTIFICATION_ENCRYPTION_KEY=
EMAIL_RECIPIENT_OVERRIDE=
RESEND_API_KEY=
PUBLIC_WEB_BASE_URL=http://127.0.0.1:32120
PUBLIC_SUPPORT_WHATSAPP_E164=+628111000000

# Synthetic adapters are test/local-only and rejected in production.
AUTH_SYNTHETIC_ENABLED=false
SYNTHETIC_BOOTSTRAP_SUPER_OWNER_EMAIL=
AUTH_SYNTHETIC_OTP_CODE=
AUTH_SYNTHETIC_RECOVERY_PROOF=
NEXT_PUBLIC_AUTH_SYNTHETIC_ENABLED=false

# Payment-proof scanner. Use synthetic only for development/test; production requires clamav.
PAYMENT_PROOF_SYNTHETIC_SCAN_RESULT=CLEAN
PAYMENT_PROOF_MAX_BYTES=10000000
PAYMENT_PROOF_SCAN_DRIVER=synthetic
PAYMENT_PROOF_CLAMAV_HOST=
PAYMENT_PROOF_CLAMAV_PORT=3310
PAYMENT_PROOF_SCAN_TIMEOUT_MS=15000
PAYMENT_PROOF_ABANDONED_TTL_MINUTES=60
PURCHASE_IDEMPOTENCY_TTL_SECONDS=

# Synthetic booking policy. Production remains fail-closed without an approved policy.
BOOKING_ENABLED=true
BOOKING_CUTOFF_HOURS=2
RESCHEDULE_ENABLED=true
RESCHEDULE_CUTOFF_HOURS=12
BOOKING_CANCELLATION_ENABLED=true
BOOKING_CANCELLATION_CUTOFF_HOURS=12
MOBILE_ACCOUNT_RECOVERY_ENABLED=false
MOBILE_REVOKE_ALL_SESSIONS_ENABLED=false
MOBILE_CUSTOMER_CHECK_IN_ENABLED=false
MOBILE_INSTRUCTOR_CHECK_IN_ENABLED=false
SESSION_ADJUSTMENT_ENABLED=true
RBAC_POLICY_SOURCE=static
RBAC_MANAGEMENT_ENABLED=false
IDENTITY_REVIEW_ENABLED=true

# v1 -> v2 migration operator. Keep disabled for normal API/worker processes.
V1_DATABASE_URL=
# Separate allowlisted adapter credential; never reuse V1_DATABASE_URL or an admin account.
V1_ROLLBACK_DATABASE_URL=
V1_DUMP_SHA256=
V1_SNAPSHOT_AT=
V1_SNAPSHOT_STARTED_AT=
V1_SNAPSHOT_COMPLETED_AT=
V1_SNAPSHOT_GTID=
V1_EXPECTED_SOURCE_MYSQL_VERSION=8.4
V1_REHEARSAL_CONFIRMATION=
V1_MAPPING_VERSION=
V1_MIGRATION_MEDIA_MODE=metadata-only
V1_BRANCH_CODES=
V1_BRANCH_TIMEZONES=
V1_MIGRATION_ACTOR_SOURCE_USER_ID=
V1_DEC006_CONFIGURATION_PACK_SHA256=
V1_PROJECTION_RATES=
V1_PROJECTION_RATE_EVIDENCE=
MIGRATION_ALLOW_WRITES=false
MIGRATION_PII_KEY_BASE64=
MIGRATION_PII_HASH_PEPPER=
MIGRATION_DELTA_KEY_BASE64=
MIGRATION_DELTA_KEY_VERSION=v1
# Optional absolute path when mysqlbinlog is not available on PATH.
MYSQLBINLOG_PATH=
# Optional connector network override (for example Docker Compose port mapping).
MYSQLBINLOG_HOST=
MYSQLBINLOG_PORT=
MIGRATION_MFA_MAX_AGE_SECONDS=900
MIGRATION_STEP_UP_TOKEN_HASH=
# Production/rehearsal API processes accept signed Finance configurations only when this
# checksum matches the compiled DEC-006 pack. Leave empty in ordinary local development.
DEC006_APPROVED_PACK_SHA256=
# OpenAPI generated-client workflow (optional local Java path; Docker is fallback only)
# OPENAPI_GENERATOR_JAR=/absolute/path/openapi-generator-cli-7.15.0.jar
# OPENAPI_GENERATOR_JAVA=/absolute/path/to/java
